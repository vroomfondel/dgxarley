# {{ ansible_managed }}
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="{{ nut_ups_vendorid }}", ATTR{idProduct}=="{{ nut_ups_productid }}", MODE="0660", GROUP="nut"
# Release the UPS interface from usbhid so NUT can claim it; DRIVER=="usbhid" keeps NUT's own usbfs claim untouched.
ACTION=="add|bind", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_interface", DRIVER=="usbhid", ATTRS{idVendor}=="{{ nut_ups_vendorid }}", ATTRS{idProduct}=="{{ nut_ups_productid }}", RUN+="/bin/sh -c 'echo $kernel > /sys/bus/usb/drivers/usbhid/unbind'"
