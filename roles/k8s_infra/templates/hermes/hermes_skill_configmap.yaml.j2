apiVersion: v1
kind: ConfigMap
metadata:
  name: "hermes-skill-{{ item.key }}"
  namespace: "{{ hermes.namespace }}"
  labels:
    app: hermes
    hermes-component: skill
data:
{% for f in item.value.files %}
  {{ (f.dest | replace('/', '__')) | to_json }}: {{ (lookup('template', item.value.root ~ '/' ~ f.src) if item.value.render and f.src != f.dest else lookup('file', item.value.root ~ '/' ~ f.src)) | to_json }}
{% endfor %}
