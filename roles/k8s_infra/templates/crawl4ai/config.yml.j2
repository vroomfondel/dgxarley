# Mounted at /app/config.yml; upstream deploy/docker/config.yml with the ops knobs from defaults/main/crawl4ai.yml.
app:
  title: "Crawl4AI API"
  version: "1.0.0"
  host: "0.0.0.0"
  port: {{ crawl4ai_port }}
  reload: False
  workers: 1
  timeout_keep_alive: 300

llm:
  provider: "{{ crawl4ai_llm_provider }}"

# Loopback redis inside the container (supervisord); the password comes from REDIS_PASSWORD at runtime.
redis:
  host: "localhost"
  port: 6379
  db: 0
  password: ""
  task_ttl_seconds: 3600
  ssl: False
  ssl_cert_reqs: None
  ssl_ca_certs: None
  ssl_certfile: None
  ssl_keyfile: None

limits:
  max_body_bytes: 10485760
  max_pages: {{ crawl4ai_max_pages }}
  max_depth: {{ crawl4ai_max_depth }}
  wall_clock_s: 300
  queue:
    maxsize: 1000
    workers: 4
    per_principal: 0

rate_limiting:
  enabled: True
  default_limit: "1000/minute"
  trusted_proxies: []
  storage_uri: "memory://"

# api_token stays empty: the bearer token is injected as CRAWL4AI_API_TOKEN from the Secret.
security:
  enabled: true
  jwt_enabled: false
  api_token: ""
  https_redirect: false
  trusted_hosts: {{ crawl4ai_trusted_hosts | to_json }}
  cors_allow_origins: []
  headers:
    x_content_type_options: "nosniff"
    x_frame_options: "DENY"
    content_security_policy: "default-src 'self'"
    strict_transport_security: "max-age=63072000; includeSubDomains"

crawler:
  base_config:
    simulate_user: true
  memory_threshold_percent: 95.0
  rate_limiter:
    enabled: true
    base_delay: [1.0, 2.0]
  timeouts:
    stream_init: 30.0
    batch_process: 300.0
  pool:
    max_pages: {{ crawl4ai_pool_max_pages }}
    idle_ttl_sec: 300
    max_pages_before_recycle: 200
  browser:
    kwargs:
      headless: true
      text_mode: true
    extra_args:
      # The container runs as non-root without a usable Chromium sandbox.
      - "--no-sandbox"
      - "--disable-dev-shm-usage"
      - "--disable-gpu"
      - "--disable-software-rasterizer"

logging:
  level: "{{ crawl4ai_log_level }}"
  format: "%(asctime)s - %(name)s - %(levelname)s - %(message)s"

observability:
  prometheus:
    enabled: True
    endpoint: "/metrics"
  health_check:
    endpoint: "/health"

webhooks:
  enabled: true
  default_url: null
  data_in_payload: false
  retry:
    max_attempts: 5
    initial_delay_ms: 1000
    max_delay_ms: 32000
    timeout_ms: 30000
  headers:
    User-Agent: "Crawl4AI-Webhook/1.0"
